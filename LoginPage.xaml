<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VodjeniTrening.LoginPage"
             Title="Uloguj se"
             SafeAreaEdges="All"
             BackgroundColor="{AppThemeBinding Light=#F5F7FB, Dark=#111827}">
    <ScrollView>
        <VerticalStackLayout Padding="26,52,26,28" Spacing="18"
                             MaximumWidthRequest="520" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="6" Margin="0,0,0,18">
                <Label Text="Vođeni trening" FontFamily="OpenSansSemibold" FontSize="32"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#111827, Dark=#F9FAFB}" />
                <Label Text="Prijavite se da biste učitali svoj trening"
                       FontSize="15" HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            </VerticalStackLayout>

            <Label Text="Korisničko ime" FontFamily="OpenSansSemibold" FontSize="15"
                   TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
            <Border Padding="14,4" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <Entry x:Name="UserNameEntry" Placeholder="Unesite korisničko ime"
                       ReturnType="Next" ClearButtonVisibility="WhileEditing"
                       AutomationId="LoginUserName" />
            </Border>

            <Label Text="Lozinka" FontFamily="OpenSansSemibold" FontSize="15"
                   TextColor="{AppThemeBinding Light=#374151, Dark=#E5E7EB}" />
            <Border Padding="14,4" BackgroundColor="{AppThemeBinding Light=White, Dark=#1F2937}"
                    Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}">
                <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                <Entry x:Name="PasswordEntry" Placeholder="Unesite lozinku" IsPassword="True"
                       ReturnType="Go" Completed="OnLoginClicked"
                       AutomationId="LoginPassword" />
            </Border>

            <Label x:Name="MessageLabel" IsVisible="False" FontSize="14"
                   HorizontalTextAlignment="Center" MaxLines="3" />
            <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False"
                               Color="#2563EB" />

            <Button x:Name="LoginButton" Text="Uloguj se" Clicked="OnLoginClicked"
                    MinimumHeightRequest="58" FontFamily="OpenSansSemibold" FontSize="19"
                    CornerRadius="18" BackgroundColor="#2563EB" TextColor="White"
                    AutomationId="LoginButton" />

            <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,8,0,0">
                <BoxView HeightRequest="1" VerticalOptions="Center"
                         Color="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}" />
                <Label Grid.Column="1" Text="Nemate nalog?" FontSize="14"
                       TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
                <BoxView Grid.Column="2" HeightRequest="1" VerticalOptions="Center"
                         Color="{AppThemeBinding Light=#D1D5DB, Dark=#4B5563}" />
            </Grid>

            <Button Text="Kreiraj nalog" Clicked="OnCreateAccountClicked"
                    MinimumHeightRequest="54" FontFamily="OpenSansSemibold" FontSize="17"
                    CornerRadius="16" BackgroundColor="Transparent"
                    BorderColor="#2563EB" BorderWidth="1.5" TextColor="#2563EB"
                    AutomationId="CreateAccountButton" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

